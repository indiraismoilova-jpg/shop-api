@startuml shop_er
!pragma layout smetana
top to bottom direction
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam nodesep 40
skinparam ranksep 65
skinparam entity {
 BackgroundColor #F5F8FC
 BorderColor #334155
 FontColor #0F172A
}
title Shop database ER diagram\nSQL migrations 001-007 | 21 tables | PK / FK / UQ | * required field
entity "users" as users {
  * id : BIGINT <<PK>>
  --
  * email : VARCHAR(254) <<UQ>>
  * password : VARCHAR(100)
  * first_name : VARCHAR(100)
  * last_name : VARCHAR(100)
    phone : VARCHAR(30)
  * role : VARCHAR(20)
  * enabled : BOOLEAN
  * email_verified : BOOLEAN
    last_login_at : TIMESTAMP(6)
  * created_at : TIMESTAMP(6)
  * updated_at : TIMESTAMP(6)
}
entity "addresses" as addresses {
  * id : BIGINT <<PK>>
  --
    title : VARCHAR(100)
  * country : VARCHAR(100)
  * city : VARCHAR(100)
  * street : VARCHAR(200)
  * building : VARCHAR(30)
    apartment : VARCHAR(30)
    postal_code : VARCHAR(20)
  * recipient_name : VARCHAR(200)
  * recipient_phone : VARCHAR(30)
  * is_default : BOOLEAN
    latitude : NUMERIC(10,7)
    longitude : NUMERIC(10,7)
  * user_id : BIGINT <<FK>>
}
entity "brands" as brands {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * slug : VARCHAR(150) <<UQ>>
    description : TEXT
    logo_url : VARCHAR(500)
    website_url : VARCHAR(500)
    country : VARCHAR(100)
  * is_active : BOOLEAN
}
entity "categories" as categories {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * slug : VARCHAR(150) <<UQ>>
    description : TEXT
    image_url : VARCHAR(500)
  * sort_order : INTEGER
  * is_active : BOOLEAN
    parent_category_id : BIGINT <<FK>>
}
entity "products" as products {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(200)
  * slug : VARCHAR(250) <<UQ>>
    description : TEXT
    short_description : VARCHAR(1000)
  * sku : VARCHAR(64) <<UQ>>
  * base_price : NUMERIC(12,2)
    discount_price : NUMERIC(12,2)
    discount_start_date : TIMESTAMP(6)
    discount_end_date : TIMESTAMP(6)
  * stock_quantity : INTEGER
  * reserved_quantity : INTEGER
  * low_stock_threshold : INTEGER
    weight : NUMERIC(10,3)
    dimensions : VARCHAR(100)
  * is_active : BOOLEAN
  * is_featured : BOOLEAN
  * is_new_arrival : BOOLEAN
  * average_rating : NUMERIC(3,2)
  * review_count : INTEGER
  * view_count : BIGINT
  * sales_count : BIGINT
    meta_title : VARCHAR(200)
    meta_description : VARCHAR(500)
  * created_at : TIMESTAMP(6)
  * updated_at : TIMESTAMP(6)
    brand_id : BIGINT <<FK>>
  * category_id : BIGINT <<FK>>
}
entity "product_variants" as product_variants {
  * id : BIGINT <<PK>>
  --
  * sku : VARCHAR(64) <<UQ>>
  * name : VARCHAR(200)
    attributes : JSONB
  * price : NUMERIC(12,2)
  * stock_quantity : INTEGER
  * reserved_quantity : INTEGER
    image_url : VARCHAR(500)
  * is_active : BOOLEAN
  * product_id : BIGINT <<FK>>
}
entity "product_images" as product_images {
  * id : BIGINT <<PK>>
  --
  * image_url : VARCHAR(500)
    thumbnail_url : VARCHAR(500)
    alt_text : VARCHAR(200)
  * is_primary : BOOLEAN
  * sort_order : INTEGER
  * product_id : BIGINT <<FK>>
}
entity "product_specifications" as product_specifications {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * value : VARCHAR(1000)
    group_name : VARCHAR(100)
  * sort_order : INTEGER
  * product_id : BIGINT <<FK>>
}
entity "reviews" as reviews {
  * id : BIGINT <<PK>>
  --
  * rating : INTEGER
    title : VARCHAR(200)
    comment : TEXT
    pros : TEXT
    cons : TEXT
    images : JSONB
  * is_verified_purchase : BOOLEAN
  * helpful_count : INTEGER
  * not_helpful_count : INTEGER
    admin_reply : TEXT
    admin_reply_at : TIMESTAMP(6)
  * status : VARCHAR(20)
  * created_at : TIMESTAMP(6)
  * updated_at : TIMESTAMP(6)
  * product_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
}
entity "carts" as carts {
  * id : BIGINT <<PK>>
  --
    session_id : VARCHAR(100)
    applied_promo_code : VARCHAR(100)
  * created_at : TIMESTAMP(6)
  * updated_at : TIMESTAMP(6)
    user_id : BIGINT <<FK>>
}
entity "cart_items" as cart_items {
  * id : BIGINT <<PK>>
  --
  * quantity : INTEGER
  * price_at_add : NUMERIC(12,2)
  * cart_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
    variant_id : BIGINT <<FK>>
}
entity "wishlists" as wishlists {
  * id : BIGINT <<PK>>
  --
  * price_at_add : NUMERIC(12,2)
  * notify_on_price_drop : BOOLEAN
  * notify_on_back_in_stock : BOOLEAN
  * added_at : TIMESTAMP(6)
  * user_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
}
entity "delivery_options" as delivery_options {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * code : VARCHAR(50) <<UQ>>
    description : TEXT
  * base_price : NUMERIC(12,2)
    free_threshold : NUMERIC(12,2)
  * estimated_days_min : INTEGER
  * estimated_days_max : INTEGER
  * is_active : BOOLEAN
}
entity "orders" as orders {
  * id : BIGINT <<PK>>
  --
  * order_number : VARCHAR(50) <<UQ>>
  * status : VARCHAR(20)
  * shipping_country : VARCHAR(100)
  * shipping_city : VARCHAR(100)
  * shipping_street : VARCHAR(200)
  * shipping_building : VARCHAR(30)
    shipping_apartment : VARCHAR(30)
    shipping_postal_code : VARCHAR(20)
  * shipping_recipient_name : VARCHAR(200)
  * shipping_recipient_phone : VARCHAR(30)
  * delivery_method : VARCHAR(30)
    delivery_tracking_number : VARCHAR(100)
    estimated_delivery_date : TIMESTAMP(6)
    actual_delivery_date : TIMESTAMP(6)
  * subtotal : NUMERIC(12,2)
  * shipping_cost : NUMERIC(12,2)
  * discount : NUMERIC(12,2)
  * bonus_points_used : INTEGER
  * bonus_points_earned : INTEGER
  * total_amount : NUMERIC(12,2)
    promo_code : VARCHAR(100)
    customer_note : TEXT
    admin_note : TEXT
  * created_at : TIMESTAMP(6)
  * updated_at : TIMESTAMP(6)
    paid_at : TIMESTAMP(6)
    shipped_at : TIMESTAMP(6)
    delivered_at : TIMESTAMP(6)
  * user_id : BIGINT <<FK>>
}
entity "order_items" as order_items {
  * id : BIGINT <<PK>>
  --
  * quantity : INTEGER
  * price_at_purchase : NUMERIC(12,2)
  * product_snapshot : JSONB
  * order_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
    variant_id : BIGINT <<FK>>
}
entity "payments" as payments {
  * id : BIGINT <<PK>>
  --
    transaction_id : VARCHAR(100) <<UQ>>
  * payment_method : VARCHAR(30)
  * status : VARCHAR(30)
  * amount : NUMERIC(12,2)
  * currency : VARCHAR(3)
  * bonus_points_used : INTEGER
    card_last_four_digits : VARCHAR(4)
    paid_at : TIMESTAMP(6)
    error_message : TEXT
    error_code : VARCHAR(100)
  * refunded_amount : NUMERIC(12,2)
    metadata : JSONB
  * order_id : BIGINT <<FK, UQ>>
}
entity "promo_codes" as promo_codes {
  * id : BIGINT <<PK>>
  --
  * code : VARCHAR(100) <<UQ>>
    description : TEXT
  * discount_type : VARCHAR(30)
  * discount_value : NUMERIC(12,2)
    min_order_amount : NUMERIC(12,2)
    max_discount_amount : NUMERIC(12,2)
    max_usage_count : INTEGER
  * current_usage_count : INTEGER
    max_usage_per_user : INTEGER
  * valid_from : TIMESTAMP(6)
  * valid_to : TIMESTAMP(6)
  * is_active : BOOLEAN
    created_by_id : BIGINT <<FK>>
}
entity "promo_code_categories" as promo_code_categories {
  * category_id : BIGINT <<PK, FK>>
  * promo_code_id : BIGINT <<PK, FK>>
  --
}
entity "promo_code_products" as promo_code_products {
  * product_id : BIGINT <<PK, FK>>
  * promo_code_id : BIGINT <<PK, FK>>
  --
}
entity "promo_code_usages" as promo_code_usages {
  * id : BIGINT <<PK>>
  --
  * discount_applied : NUMERIC(12,2)
  * used_at : TIMESTAMP(6)
  * promo_code_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  * order_id : BIGINT <<FK>>
}
entity "refresh_tokens" as refresh_tokens {
  * id : BIGINT <<PK>>
  --
  * token : VARCHAR(512) <<UQ>>
  * expiry_date : TIMESTAMP(6)
  * revoked : BOOLEAN
  * created_at : TIMESTAMP(6)
  * user_id : BIGINT <<FK>>
}
users ||--o{ addresses : user_id
categories |o--o{ categories : parent_category_id
brands |o--o{ products : brand_id
categories ||--o{ products : category_id
products ||--o{ product_variants : product_id
products ||--o{ product_images : product_id
products ||--o{ product_specifications : product_id
products ||--o{ reviews : product_id
users ||--o{ reviews : user_id
users |o--o{ carts : user_id
carts ||--o{ cart_items : cart_id
products ||--o{ cart_items : product_id
product_variants |o--o{ cart_items : variant_id
users ||--o{ wishlists : user_id
products ||--o{ wishlists : product_id
users ||--o{ orders : user_id
orders ||--o{ order_items : order_id
products ||--o{ order_items : product_id
product_variants |o--o{ order_items : variant_id
orders ||--o| payments : order_id
users |o--o{ promo_codes : created_by_id
promo_codes ||--o{ promo_code_categories : promo_code_id
categories ||--o{ promo_code_categories : category_id
promo_codes ||--o{ promo_code_products : promo_code_id
products ||--o{ promo_code_products : product_id
promo_codes ||--o{ promo_code_usages : promo_code_id
users ||--o{ promo_code_usages : user_id
orders ||--o{ promo_code_usages : order_id
users ||--o{ refresh_tokens : user_id
legend bottom
  Crow foot = many; circle = optional; bar = one.
  DeliveryOption.code maps to Order.delivery_method; there is no physical foreign key.
  Shipping address is embedded in orders as a historical snapshot.
  PromoCode.code is copied into carts/orders; associations and usage rows have foreign keys.
endlegend
@enduml
